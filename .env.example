# ============================================================================
# Multi-Agent OpenShift Builds Configuration
# ============================================================================
# This file contains all environment variables needed to run the multi-agent
# development orchestrator for Shipwright using Claude Code + LangGraph.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Required Configuration
# ----------------------------------------------------------------------------

# Anthropic Claude API Key (REQUIRED)
# Get your API key from: https://console.anthropic.com/settings/keys
# The design agent uses Claude API to analyze feature requests and generate
# comprehensive design documents with impact analysis and risk assessment.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------------------------------------------
# Repository Paths (OPTIONAL)
# ----------------------------------------------------------------------------

# Path to Shipwright Build Repository
# If provided, the design agent will analyze the actual codebase to gather
# context about API types, controllers, CRDs, and package structure.
# If not set, analysis will be based on component metadata only.
# Example: /path/to/shipwright-build or /home/user/git/shipwright-build
SHIPWRIGHT_REPO_PATH=

# Path to OpenShift Builds Repository
# Optional path to the OpenShift builds repository for additional context.
# If not set, the agent will work with Shipwright repository only.
# Example: /path/to/openshift-builds or /home/user/git/openshift-builds
OPENSHIFT_BUILDS_REPO_PATH=

# ----------------------------------------------------------------------------
# Logging Configuration (OPTIONAL)
# ----------------------------------------------------------------------------

# Logging Level
# Controls the verbosity of application logs.
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Log Format
# Format for log output.
# Valid values: json, text
# Default: text
LOG_FORMAT=text

# Log File Path
# Optional path to write logs to a file.
# If not set, logs will only be written to stdout.
# Example: /tmp/muilti-agents-ocp-builds.log
LOG_FILE_PATH=

# ----------------------------------------------------------------------------
# Claude Model Configuration (OPTIONAL)
# ----------------------------------------------------------------------------

# Claude Model Version
# Specifies which Claude model version to use for design analysis.
# Default: claude-sonnet-4-20250514
# Other options: claude-opus-4-20250514, claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum Tokens for Claude Response
# Controls the maximum length of Claude's response.
# Default: 8000
# Range: 1024-8192 (depending on model)
CLAUDE_MAX_TOKENS=8000

# ----------------------------------------------------------------------------
# Agent Configuration (OPTIONAL)
# ----------------------------------------------------------------------------

# Enable Design Agent Repository Analysis
# When set to true, the design agent will analyze the repository structure
# even if SHIPWRIGHT_REPO_PATH is not provided (requires git repository).
# Default: true
ENABLE_REPO_ANALYSIS=true

# Design Agent Output Format
# Format for design agent output.
# Valid values: markdown, json
# Default: markdown
DESIGN_OUTPUT_FORMAT=markdown

# ----------------------------------------------------------------------------
# Development Settings (OPTIONAL)
# ----------------------------------------------------------------------------

# Enable Debug Mode
# When set to true, enables additional debug logging and error details.
# Default: false
DEBUG=false

# Dry Run Mode
# When set to true, the orchestrator will not make actual API calls
# or repository modifications. Useful for testing configuration.
# Default: false
DRY_RUN=false

# ----------------------------------------------------------------------------
# Performance Tuning (OPTIONAL)
# ----------------------------------------------------------------------------

# API Request Timeout (seconds)
# Maximum time to wait for Claude API responses.
# Default: 60
API_TIMEOUT=60

# Max Repository Files to Analyze
# Limits the number of files analyzed during repository context gathering.
# Default: 100
MAX_REPO_FILES=100

# Cache Directory
# Directory for caching repository analysis results.
# Default: .cache
CACHE_DIR=.cache

# Cache TTL (seconds)
# Time-to-live for cached repository analysis.
# Default: 3600 (1 hour)
CACHE_TTL=3600

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. The ANTHROPIC_API_KEY is the only required variable. All agents use
#    this key to interact with Claude API.
#
# 2. Repository paths are optional but highly recommended for accurate
#    design analysis. The design agent will provide better context when
#    it can analyze actual code structure.
#
# 3. All paths should be absolute paths (not relative paths).
#
# 4. Environment variables can also be set directly in your shell:
#      export ANTHROPIC_API_KEY="your_key_here"
#
# 5. For development, you can use a .env.local file that won't be committed:
#      cp .env.example .env.local
#      # Add .env.local to .gitignore
#
# 6. Make sure to keep your API keys secure and never commit them to
#    version control.
# ============================================================================
